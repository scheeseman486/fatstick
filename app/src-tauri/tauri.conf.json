{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playlist2USB",
  "version": "0.1.0",
  "identifier": "net.playlist2usb.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Playlist2USB",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Playlist to USB stick, in the order cheap players use",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["m3u", "m3u8"], "name": "M3U playlist", "role": "Viewer" },
      { "ext": ["xspf"], "name": "XSPF playlist", "role": "Viewer" },
      { "ext": ["pls"], "name": "PLS playlist", "role": "Viewer" }
    ]
  }
}
