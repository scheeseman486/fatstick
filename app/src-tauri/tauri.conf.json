{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fatstick",
  "version": "0.1.0",
  "identifier": "net.fatstick.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fatstick",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Playlists onto USB sticks, in the order cheap players use",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "M3U playlist",
        "role": "Viewer"
      },
      {
        "ext": [
          "xspf"
        ],
        "name": "XSPF playlist",
        "role": "Viewer"
      },
      {
        "ext": [
          "pls"
        ],
        "name": "PLS playlist",
        "role": "Viewer"
      }
    ],
    "resources": {
      "../../COPYING": "licenses/COPYING.txt",
      "../../packaging/licenses/LGPL-2.1.txt": "licenses/LGPL-2.1.txt",
      "../../packaging/licenses/LGPL-2.0.txt": "licenses/LGPL-2.0.txt",
      "../../packaging/licenses/THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    },
    "license": "GPL-3.0-or-later"
  }
}
